# Copy to .env.local for local runs; set the same values in Vercel → Project → Settings → Environment Variables.

# Postgres (Supabase: Project settings → Database → Connection string → "Transaction pooler", port 6543)
DATABASE_URL=

# Public URL of the deployed app (used to build the survey link Prolific sends people to)
APP_URL=https://your-app.vercel.app

# Protects /api/cron/daily. Vercel Cron sends it automatically when this env var is set.
CRON_SECRET=

# --- Prolific ---
PROLIFIC_API_TOKEN=
# Leave false until you've tested the survey end to end; true = the daily job publishes a paid study.
PROLIFIC_AUTO_PUBLISH=false
PROLIFIC_PROJECT_ID=
# Eligibility filters as JSON (UK residents, etc.) — see README → "Prolific setup"
PROLIFIC_FILTERS_JSON=
DAILY_COMPLETES=175
SURVEY_MINUTES=8
PROLIFIC_HOURLY_GBP=9

# --- Natural-language search (optional; rules-based parser is used without it) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# --- Guardrails: publishing is held (last good data stays live) if any is breached ---
GUARD_MIN_WEEKLY_VALID=300
GUARD_MAX_EXCLUSION_RATE=0.25
GUARD_MAX_SCORE_SWING=15
# Optional: Slack incoming webhook for alerts
ALERT_WEBHOOK_URL=

# Consumer-facing name
NEXT_PUBLIC_BRAND=Streaming Machine
